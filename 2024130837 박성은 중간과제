function getCandidates(slot){return garments.filter(item=>item.slot===slot);}
function scoreItem(item,context,targetClo,role){const mood=moodSelect.value, fashionW=fashionWeight(); let cloFit=0; if(role==='top'){const ideal=Math.min(0.22,targetClo*0.28+0.05); cloFit=3.8-Math.abs(item.clo-ideal)*15;} else if(role==='mid'){const ideal=Math.max(0,Math.min(0.35,targetClo*0.24)); cloFit=4.0-Math.abs(item.clo-ideal)*12;} else if(role==='outer'){const ideal=Math.max(0.12,Math.min(0.75,targetClo*0.48+context.windNeed*0.12+context.rainNeed*0.04)); cloFit=5.0-Math.abs(item.clo-ideal)*8;} else if(role==='bottom'){const ideal=Math.min(0.28,Math.max(0.04,targetClo*0.18)); cloFit=3.2-Math.abs(item.clo-ideal)*12;} else if(role==='shoes'){cloFit=2.0-Math.abs(item.clo-0.02)*18;} else {cloFit=1.5;} let practical=0; practical+=item.windproof*context.windNeed*2.8; practical+=item.water_resistant*context.rainNeed*2.8; practical+=item.koreanFreq*1.3; practical+=moodBoost(item,mood); practical+=(item.vibe+item.polish)*0.35*fashionW; if(context.env==='indoor'&&item.slot==='outer') practical-=1.1; if(context.env==='indoor'&&item.code==='umbrella') practical-=2.4; if(mood==='light'&&['padding','field-jacket','wool-coat','warm-pants'].includes(item.code)) practical-=0.8; if(mood==='comfy'&&['loafers','trench','slacks'].includes(item.code)) practical-=0.35; if(mood==='polished'&&['jogger','windbreaker'].includes(item.code)) practical-=0.8; if(mood==='dressup'&&['jogger','windbreaker','shorts','cap','sneakers'].includes(item.code)) practical-=1.0; if(mood==='dressup'&&['shirt','basic-jacket','trench','wool-coat','slacks','loafers','knit'].includes(item.code)) practical+=0.9; if(mood==='practical'&&['trench','loafers'].includes(item.code)) practical-=0.4; if(context.effectiveFeel>=25&&['padding','wool-coat','muffler','warm-pants'].includes(item.code)) practical-=4.0; if(context.effectiveFeel<=7&&['short-tee','shorts'].includes(item.code)) practical-=4.4; if(context.tempGap>=7&&['cardigan','carry-layer'].includes(item.code)) practical+=1.0; if(context.rainNeed>=0.8&&item.code==='umbrella') practical+=2.4; if(context.rainNeed>=0.65&&item.code==='water-shoes') practical+=1.5; if(context.windNeed>=0.7&&item.code==='windbreaker') practical+=2.0; if(context.windNeed>=0.6&&item.code==='muffler') practical+=1.0; return cloFit+practical;}
function chooseTopLayer(context){return getCandidates('top').map(item=>({...item,score:scoreItem(item,context,context.neededClo,'top')})).sort((a,b)=>b.score-a.score)[0];}
function chooseMidLayer(context,topItem){ if(context.neededClo<0.45&&context.tempGap<6&&context.effectiveFeel>=18) return null; const midItems=getCandidates('mid').filter(item=>item.layersWith.includes(topItem.code)||['cardigan','fleece','sweatshirt','knit'].includes(item.code)); const best=midItems.map(item=>{let score=scoreItem(item,context,context.neededClo,'mid'); if(topItem.code==='shirt'&&['cardigan','knit'].includes(item.code)) score+=0.8; if(topItem.code==='short-tee'&&item.code==='knit') score-=0.4; if(context.effectiveFeel>=22&&['knit','fleece'].includes(item.code)) score-=1.6; return {...item,score};}).sort((a,b)=>b.score-a.score)[0]; if(!best||best.score<1.6) return null; return best;}
function chooseOuterLayer(context,topItem,midItem){ if(context.effectiveFeel>=25&&context.windNeed<0.35&&context.rainNeed<0.25&&context.tempGap<6) return null; const best=getCandidates('outer').filter(item=>{const okWithTop=item.layersWith.includes(topItem.code); const okWithMid=!midItem||item.layersWith.includes(midItem.code)||['wool-coat','padding','field-jacket','windbreaker'].includes(item.code); return okWithTop&&okWithMid;}).map(item=>{let score=scoreItem(item,context,context.neededClo,'outer'); if(context.windNeed>=0.7&&item.code==='windbreaker') score+=1.2; if(context.rainNeed>=0.55&&['windbreaker','trench'].includes(item.code)) score+=0.8; if(context.effectiveFeel<=8&&item.code==='padding') score+=1.8; if(context.effectiveFeel<=13&&item.code==='wool-coat') score+=1.0; if(context.effectiveFeel>=19&&item.code==='padding') score-=4.2; if(context.effectiveFeel>=22&&['wool-coat','field-jacket'].includes(item.code)) score-=1.5; return {...item,score};}).sort((a,b)=>b.score-a.score)[0]; if(!best||best.score<1.2) return null; return best;}
function chooseBottom(context){ const mood=moodSelect.value; return getCandidates('bottom').map(item=>{let score=scoreItem(item,context,context.neededClo,'bottom'); if(context.effectiveFeel>=24&&item.code==='shorts') score+=1.2; if(context.effectiveFeel<=10&&item.code==='warm-pants') score+=1.1; if(mood==='polished'&&item.code==='slacks') score+=1.2; if(mood==='dressup'&&['slacks','cotton-pants'].includes(item.code)) score+=1.3; if(mood==='kkuan'&&['wide-pants','jeans','cotton-pants'].includes(item.code)) score+=0.8; if(mood==='comfy'&&['jogger','wide-pants','jeans'].includes(item.code)) score+=0.8; if(mood==='practical'&&['jeans','cotton-pants'].includes(item.code)) score+=0.7; if(mood==='light'&&['wide-pants','shorts'].includes(item.code)) score+=0.8; return {...item,score};}).sort((a,b)=>b.score-a.score)[0];}
function chooseShoes(context){ const mood=moodSelect.value; return getCandidates('shoes').map(item=>{let score=scoreItem(item,context,context.neededClo,'shoes'); if(context.rainNeed>=0.65&&item.code==='water-shoes') score+=1.7; if(mood==='polished'&&item.code==='loafers') score+=0.9; if(mood==='dressup'&&item.code==='loafers') score+=1.2; if(mood==='comfy'&&item.code==='sneakers') score+=0.8; if(mood==='practical'&&item.code==='sneakers') score+=0.7; return {...item,score};}).sort((a,b)=>b.score-a.score)[0];}
function chooseAccessories(context){ const items=[]; if(context.rainNeed>=0.45) items.push(garments.find(x=>x.code==='umbrella')); if(context.effectiveFeel<=8||context.windNeed>=0.75) items.push(garments.find(x=>x.code==='muffler')); if(context.tempGap>=7&&context.effectiveFeel>=14) items.push(garments.find(x=>x.code==='carry-layer')); if(context.effectiveFeel>=20&&context.rainNeed<0.55&&context.windNeed<0.7&&moodSelect.value!=='polished') items.push(garments.find(x=>x.code==='cap')); return items.filter(Boolean).slice(0,2);}
function buildOutfit(context){const top=chooseTopLayer(context), mid=chooseMidLayer(context,top), outer=chooseOuterLayer(context,top,mid), bottom=chooseBottom(context), shoes=chooseShoes(context), accessories=chooseAccessories(context); const mainItems=[top,mid,outer,bottom,shoes].filter(Boolean); const totalClo=mainItems.reduce((sum,item)=>sum+item.clo,0)+accessories.reduce((sum,item)=>sum+item.clo,0); return {top,mid,outer,bottom,shoes,accessories,totalClo:Number(totalClo.toFixed(2))};}
function slotLabel(slot){const labels={top:'상의',mid:'중간 레이어',outer:'아우터',bottom:'하의',shoes:'신발',acc:'소품'}; return labels[slot]||slot;}
function getReasonBadges(item,context){const badges=[]; if(item.clo>=0.3) badges.push('보온 적합'); if(item.windproof>=0.5&&context.windNeed>=0.45) badges.push('바람 대응'); if(item.water_resistant>=0.4&&context.rainNeed>=0.45) badges.push('비 대응'); if(item.moodTags.includes(moodSelect.value)) badges.push('코디 방향성에 어울림'); if(item.slot==='bottom'&&['wide-pants','jeans','slacks','cotton-pants','jogger'].includes(item.code)) badges.push('자주 입는 하의'); if(item.slot==='outer'&&['basic-jacket','field-jacket','trench','wool-coat'].includes(item.code)) badges.push('실용적 코디'); return badges.slice(0,3);}
function renderOutfit(outfit,context){const items=[outfit.top,outfit.mid,outfit.outer,outfit.bottom,outfit.shoes,...outfit.accessories].filter(Boolean); outfitList.innerHTML=items.map(item=>{const scoreDisplay=item.score?item.score.toFixed(1):item.clo.toFixed(2); const sub=item.slot==='acc'?`${item.desc}`:`${item.desc} · clo ${item.clo.toFixed(2)}`; const badges=getReasonBadges(item,context).map(b=>`<span class="reason-badge">${b}</span>`).join(''); return `<div class="outfit-item"><div class="left"><div class="badge">${slotLabel(item.slot)}</div><div class="name">${item.name}</div><div class="desc">${sub}</div><div class="reason-badges">${badges}</div></div><div class="score">${scoreDisplay}</div></div>`;}).join(''); document.getElementById('neededCloBox').textContent=`${context.neededClo.toFixed(2)} clo`; document.getElementById('outfitCloBox').textContent=`${outfit.totalClo.toFixed(2)} clo`; document.getElementById('rainNeedBox').textContent=context.rainNeed>=0.8?'높음':context.rainNeed>=0.45?'중간':'낮음'; document.getElementById('windNeedBox').textContent=context.windNeed>=0.8?'높음':context.windNeed>=0.45?'중간':'낮음';}
function buildExplanation(outfit,context){const parts=[]; parts.push(`선택한 시간대의 대표 체감온도는 약 <strong>${Math.round(context.effectiveFeel)}°C</strong>로 계산되어 필요한 보온량을 <strong>${context.neededClo.toFixed(2)} clo</strong> 정도로 보았습니다.`); parts.push(`추천된 조합의 총 보온량은 <strong>${outfit.totalClo.toFixed(2)} clo</strong>이며, 현재 선택한 코디 방향성인 <strong>${moodLabel(moodSelect.value)}</strong>을 함께 반영했습니다.`); if(context.windNeed>=0.6) parts.push(`풍속이 강한 편이라 <strong>바람막이·야상·패딩처럼 방풍성이 있는 아우터</strong>를 더 우대했습니다.`); if(context.rainNeed>=0.45) parts.push(`강수 가능성이 있어 <strong>우산</strong>이나 <strong>방수 신발</strong> 같은 실용 요소를 함께 고려했습니다.`); if(context.tempGap>=7) parts.push(`시간대별 기온차가 커서 <strong>가디건</strong>이나 <strong>얇은 겉옷 휴대</strong>처럼 벗고 입기 쉬운 구성을 선호하도록 했습니다.`); const feedbackBias=getFeedbackBias(); if(feedbackBias!==0) parts.push(`이전 피드백을 반영해 추천 보온량을 <strong>${feedbackBias>=0?'+':''}${feedbackBias.toFixed(2)} clo</strong>만큼 보정했습니다.`); explainBox.innerHTML=parts.join('<br><br>');}
function renderCandidates(context){const mood=moodSelect.value, fashionW=fashionWeight(); const candidates=garments.filter(item=>['top','mid','outer','bottom'].includes(item.slot)).map(item=>{const score=(2.8-Math.abs(item.clo-Math.min(context.neededClo,0.45))*4)+item.windproof*context.windNeed*1.4+item.water_resistant*context.rainNeed*1.4+moodBoost(item,mood)+(item.vibe+item.polish)*0.22*fashionW; return {item,score};}).sort((a,b)=>b.score-a.score).slice(0,10); candidateChips.innerHTML=candidates.map(({item})=>`<span class="chip">${item.name}</span>`).join('');}
function recommendOutfit(snapshot){const context=computeNeed(snapshot), outfit=buildOutfit(context); renderOutfit(outfit,context); buildExplanation(outfit,context); renderCandidates(context); updateFeedbackUI();}
async function updateWeatherForPoint(lat,lon,label='선택 위치'){ try{ setStatus('날씨 데이터를 불러오는 중입니다...'); setMarker(lat,lon,label); const data=await fetchWeather(lat,lon); const selectedRange=buildSelectedTimeRange(); const snapshot=summarizeRange(data.hourly,selectedRange.startDate,selectedRange.endDate); weatherSnapshot=snapshot; showWeather(snapshot); recommendOutfit(snapshot); setStatus(`날씨 조회 완료: ${label}`);} catch(err){ console.error(err); setStatus(`오류: ${err.message}`);} }
map.on('click',(e)=>{const {lat,lng}=e.latlng; updateWeatherForPoint(lat,lng,`위도 ${lat.toFixed(3)}, 경도 ${lng.toFixed(3)}`);});
searchBtn.addEventListener('click',async()=>{const q=locationInput.value.trim(); if(!q){setStatus('도시명을 입력해 주세요.'); return;} try{setStatus('도시를 검색하는 중입니다...'); const place=await geocodeCity(q); const label=`${place.name}${place.admin1?', '+place.admin1:''}${place.country?', '+place.country:''}`; updateWeatherForPoint(place.latitude,place.longitude,label);} catch(err){console.error(err); setStatus(`오류: ${err.message}`);}});
postalBtn.addEventListener('click',async()=>{const postal=postalInput.value.trim(), country=(countryInput.value.trim()||'KR'); if(!postal){setStatus('우편번호를 입력해 주세요.'); return;} try{setStatus('우편번호를 검색하는 중입니다...'); const place=await geocodePostal(postal,country); const lat=Number(place.lat), lon=Number(place.lon), label=`${place.display_name}`; updateWeatherForPoint(lat,lon,label);} catch(err){console.error(err); setStatus(`오류: ${err.message}`);}});
coordBtn.addEventListener('click',()=>{const lat=Number(latInput.value.trim()), lon=Number(lonInput.value.trim()); if(Number.isNaN(lat)||Number.isNaN(lon)){setStatus('올바른 위도와 경도를 입력해 주세요.'); return;} updateWeatherForPoint(lat,lon,`직접 입력 좌표 (${lat.toFixed(3)}, ${lon.toFixed(3)})`);});
seoulBtn.addEventListener('click',()=>{locationInput.value='Seoul'; updateWeatherForPoint(37.5665,126.9780,'Seoul, KR');});
locationInput.addEventListener('keydown',(e)=>{if(e.key==='Enter') searchBtn.click();}); postalInput.addEventListener('keydown',(e)=>{if(e.key==='Enter') postalBtn.click();}); latInput.addEventListener('keydown',(e)=>{if(e.key==='Enter') coordBtn.click();}); lonInput.addEventListener('keydown',(e)=>{if(e.key==='Enter') coordBtn.click();});
gpsBtn.addEventListener('click',()=>{if(!navigator.geolocation){setStatus('이 브라우저에서는 위치 기능을 사용할 수 없습니다.'); return;} setStatus('현재 위치를 확인하는 중입니다...'); navigator.geolocation.getCurrentPosition((pos)=>{updateWeatherForPoint(pos.coords.latitude,pos.coords.longitude,'내 위치');},(err)=>{setStatus(`위치 권한 또는 조회 오류: ${err.message}`);},{enableHighAccuracy:true,timeout:10000});});
refreshBtn.addEventListener('click',()=>{if(!selectedPoint){setStatus('먼저 위치를 선택해 주세요.'); return;} updateWeatherForPoint(selectedPoint.lat,selectedPoint.lon,selectedPoint.label);});
goodBtn.addEventListener('click',()=>setFeedback('good')); coldBtnFeedback.addEventListener('click',()=>setFeedback('cold')); hotBtn.addEventListener('click',()=>setFeedback('hot'));
[startTimeInput,endTimeInput,moodSelect,rangeStrategy,coldSlider,rainSlider,windSlider,envSelect,indoorTemp,fashionSlider].forEach(el=>{el.addEventListener('input',()=>{updatePreferenceLabels(); if(selectedPoint) updateWeatherForPoint(selectedPoint.lat,selectedPoint.lon,selectedPoint.label);}); el.addEventListener('change',()=>{updatePreferenceLabels(); if(selectedPoint) updateWeatherForPoint(selectedPoint.lat,selectedPoint.lon,selectedPoint.label);});});
updatePreferenceLabels(); updateFeedbackUI(); renderChips();
</script>
