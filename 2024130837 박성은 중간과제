function computeNeed(snapshot){const coldPref=Number(coldSlider.value), rainPref=Number(rainSlider.value), windPref=Number(windSlider.value), env=envSelect.value, indoor=Number(indoorTemp.value), strategy=rangeStrategy.value, feedbackBias=getFeedbackBias(); let outdoorFeel; if(strategy==='cautious') outdoorFeel=snapshot.minFeel; else if(strategy==='light') outdoorFeel=snapshot.maxFeel; else outdoorFeel=snapshot.avgFeel; let effectiveFeel=outdoorFeel; if(env==='indoor') effectiveFeel=indoor; else if(env==='mixed') effectiveFeel=outdoorFeel*0.58+indoor*0.42; let neededClo; if(effectiveFeel>=28) neededClo=0.10; else if(effectiveFeel>=24) neededClo=0.18; else if(effectiveFeel>=21) neededClo=0.28; else if(effectiveFeel>=18) neededClo=0.38; else if(effectiveFeel>=15) neededClo=0.52; else if(effectiveFeel>=12) neededClo=0.68; else if(effectiveFeel>=9) neededClo=0.85; else if(effectiveFeel>=5) neededClo=1.02; else if(effectiveFeel>=0) neededClo=1.20; else neededClo=1.38; neededClo+=coldPref*0.08; neededClo+=feedbackBias; if(env!=='indoor'){ if(snapshot.maxWind>=20) neededClo+=0.05+windPref*0.03; if(snapshot.maxWind>=32) neededClo+=0.07; } let rainNeed=0; if(env!=='indoor'){ if(snapshot.maxRainProb>=70) rainNeed=1.0; else if(snapshot.maxRainProb>=45) rainNeed=0.65; else if(snapshot.maxRainProb>=25) rainNeed=0.35; rainNeed+=rainPref*0.12; } let windNeed=0; if(env!=='indoor'){ if(snapshot.maxWind>=32) windNeed=1.0; else if(snapshot.maxWind>=22) windNeed=0.65; else if(snapshot.maxWind>=12) windNeed=0.35; windNeed+=windPref*0.10; } const tempGap=snapshot.maxFeel-snapshot.minFeel; return {neededClo:Math.max(0.08,Number(neededClo.toFixed(2))),rainNeed:Math.min(1.2,Number(rainNeed.toFixed(2))),windNeed:Math.min(1.2,Number(windNeed.toFixed(2))),effectiveFeel,env,indoor,outdoorFeel,tempGap};}
function moodBoost(item,mood){ if(item.moodTags.includes(mood)) return mood==='dressup'?1.8:1.5; if(mood==='kkuan'&&item.moodTags.includes('polished')) return 0.9; if(mood==='dressup'&&item.moodTags.includes('polished')) return 1.1; if(mood==='practical'&&item.moodTags.includes('comfy')) return 0.6; return 0;}
