async function geocodeCity(query){const url=`https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(query)}&count=1&language=ko&format=json`; const res=await fetch(url); if(!res.ok) throw new Error('도시 검색 실패'); const data=await res.json(); if(!data.results||!data.results.length) throw new Error('검색 결과 없음'); return data.results[0];}
async function geocodePostal(postal,country){const url=`https://nominatim.openstreetmap.org/search?postalcode=${encodeURIComponent(postal)}&countrycodes=${encodeURIComponent(country.toLowerCase())}&format=jsonv2&limit=1`; const res=await fetch(url,{headers:{'Accept':'application/json'}}); if(!res.ok) throw new Error('우편번호 검색 실패'); const data=await res.json(); if(!data||!data.length) throw new Error('해당 우편번호 결과 없음'); return data[0];}
async function fetchWeather(lat,lon){const url=`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&hourly=temperature_2m,apparent_temperature,precipitation_probability,weather_code,wind_speed_10m&current=temperature_2m,apparent_temperature,precipitation_probability,weather_code,wind_speed_10m&timezone=auto&forecast_days=3`; const res=await fetch(url); if(!res.ok) throw new Error('날씨 조회 실패'); return res.json();}
function parseTimeValue(value,fallback){const raw=value||fallback; const [hour,minute]=raw.split(':').map(Number); return {hour:Number.isFinite(hour)?hour:0, minute:Number.isFinite(minute)?minute:0, label:raw};}
function buildSelectedTimeRange(){const now=new Date(); const start=parseTimeValue(startTimeInput.value,'09:00'), end=parseTimeValue(endTimeInput.value,'18:00'); const startDate=new Date(now); startDate.setHours(start.hour,start.minute,0,0); const endDate=new Date(now); endDate.setHours(end.hour,end.minute,0,0); if(startDate.getTime()<now.getTime()-30*60*1000){startDate.setDate(startDate.getDate()+1); endDate.setDate(endDate.getDate()+1);} if(endDate<=startDate) endDate.setDate(endDate.getDate()+1); return {startDate,endDate};}
function pickHourlyIndexByDate(times,targetDate){ if(!times||!times.length) return 0; let bestIdx=0,bestDiff=Infinity; times.forEach((t,i)=>{const diff=Math.abs(new Date(t).getTime()-targetDate.getTime()); if(diff<bestDiff){bestDiff=diff; bestIdx=i;}}); return bestIdx; }
function summarizeRange(hourly,startDate,endDate){const startIdx=pickHourlyIndexByDate(hourly.time,startDate), endIdx=pickHourlyIndexByDate(hourly.time,endDate), from=Math.min(startIdx,endIdx), to=Math.max(startIdx,endIdx); const temps=hourly.temperature_2m.slice(from,to+1), feels=hourly.apparent_temperature.slice(from,to+1), rains=hourly.precipitation_probability.slice(from,to+1).map(v=>v??0), winds=hourly.wind_speed_10m.slice(from,to+1), codes=hourly.weather_code.slice(from,to+1), times=hourly.time.slice(from,to+1), avg=arr=>arr.reduce((a,b)=>a+b,0)/arr.length; return {minTemp:Math.min(...temps),maxTemp:Math.max(...temps),minFeel:Math.min(...feels),maxFeel:Math.max(...feels),avgFeel:avg(feels),maxRainProb:Math.max(...rains),avgRainProb:avg(rains),maxWind:Math.max(...winds),avgWind:avg(winds),dominantCode:codes[Math.floor(codes.length/2)],timeText:`${times[0]} ~ ${times[times.length-1]}`,startTimeText:times[0],endTimeText:times[times.length-1]};}
